<?xml version="1.0" encoding="UTF-8"?>
<!-- REFUSAL EXAMPLE: a row with no citation.
     Row 2 carries a rule id and an effective date but an empty
     `duly:citation`. Every duly rule cites its authority; the compiler will
     not invent a `TODO(verify)` on an author's behalf, because a machine-
     written "unverified" marker is indistinguishable from a human one that
     was actually considered. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:duly="urn:duly:dmn:0.1"
             id="uncitedRow" name="uncited row"
             namespace="urn:duly:example:refusal:uncited-row">
  <extensionElements>
    <duly:pack name="refusal-uncited-row" version="0.0.1"/>
  </extensionElements>

  <decision id="category" name="trid:toleranceCategory">
    <question>Which tolerance category applied to this fee?</question>
    <extensionElements>
      <duly:decision entityType="trid:Fee" attribute="trid:toleranceCategory"
                     valueKind="code" codeSystem="duly-starter-trid/tolerance-categories"
                     codeSystemVersion="0.1.0"/>
    </extensionElements>
    <decisionTable id="categoryTable" hitPolicy="UNIQUE">
      <input id="uFeeType" label="feeType">
        <inputExpression typeRef="string"><text>trid:feeType</text></inputExpression>
      </input>
      <output id="uCategory" label="category" typeRef="string"/>
      <annotation name="duly:ruleId"/>
      <annotation name="duly:citation"/>
      <annotation name="duly:effectiveFrom"/>

      <rule id="uRow1">
        <inputEntry><text>"TransferTax"</text></inputEntry>
        <outputEntry><text>"ZeroTolerance"</text></outputEntry>
        <annotationEntry><text>REFUSE-CITE-01</text></annotationEntry>
        <annotationEntry><text>12 CFR 1026.19(e)(3)(i)</text></annotationEntry>
        <annotationEntry><text>2015-10-03</text></annotationEntry>
      </rule>

      <rule id="uRow2">
        <inputEntry><text>"RecordingFee"</text></inputEntry>
        <outputEntry><text>"TenPercentTolerance"</text></outputEntry>
        <annotationEntry><text>REFUSE-CITE-02</text></annotationEntry>
        <annotationEntry><text></text></annotationEntry>
        <annotationEntry><text>2015-10-03</text></annotationEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
